# Backend server port (used by server/index.js)
PORT=5000

# Gmail address that sends & receives your contact form emails
SMTP_USER=adwaith87140@gmail.com

# 16-character Gmail App Password (from Google Account -> Security -> App passwords)
SMTP_PASS=

# Optional: override recipient email (defaults to SMTP_USER)
CONTACT_TO_EMAIL=adwaith87140@gmail.com

# Optional: custom SMTP provider instead of Gmail (leave blank to use Gmail)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
